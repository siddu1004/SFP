        "name": "career-ops",
        "ref": "claude/claude-code-plugin",
        "setup": "npm install"
      }
    },
    "session-memory": {
      "description": "Persistent memory across Claude Code sessions (claude-mem), with search, timelines and handoffs. Claude Code only: it needs claude-mem's hooks and worker.",
