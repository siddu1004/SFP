 ## Quick Start
 
+**As a Claude Code plugin:**
+
+```
+/plugin marketplace add siddu1004/career-ops-for-claude-skill
+/plugin install career-ops@career-ops
+```
+
+Then run `/career-ops:career-ops`. Your CV, profile, tracker and reports live in `~/career-ops` (set `CAREER_OPS_ROOT` to use another folder), so plugin updates never touch them.
+
 **Fastest way, one command:**
 
 ```bash
diff --git a/path-resolver.mjs b/path-resolver.mjs
index fc91ac63..dc89de83 100644
--- a/path-resolver.mjs
+++ b/path-resolver.mjs
@@ -1,13 +1,15 @@
 import { resolve, dirname, join, basename, parse, sep } from 'path';
 import { fileURLToPath } from 'url';
 import { existsSync, readFileSync, realpathSync } from 'fs';
+import { homedir } from 'os';
 
 const __dirname = dirname(fileURLToPath(import.meta.url));
 
 /**
  * Returns the resolved career-ops data directory root.
  * Priority: process.env.CAREER_OPS_ROOT or process.env.CAREER_OPS_DATA_DIR >
- * .career-ops-data marker file > codebase root (__dirname).
+ * .career-ops-data marker file > ~/career-ops when running from a Claude Code
+ * plugin install > codebase root (__dirname).
  * 
  * @returns {string} Absolute path to the data root
  */
@@ -27,9 +29,25 @@ export function getCareerOpsRoot() {
       // ignore read errors
     }
   }
+  // A Claude Code plugin install lives in a cache that is replaced on every
+  // plugin update, so user data must not default to the codebase root there.
+  if (isClaudePluginInstall(__dirname)) {
+    return join(homedir(), 'career-ops');
+  }
   return __dirname;
 }
 
+/**
+ * True when the codebase was installed as a Claude Code plugin
+ * (~/.claude/plugins/cache/...).
+ *
+ * @param {string} dir Codebase directory
+ * @returns {boolean}
+ */
+export function isClaudePluginInstall(dir) {
+  return dir.includes(`${sep}.claude${sep}plugins${sep}cache${sep}`);
+}
