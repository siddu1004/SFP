diff --git a/tests/unit/cloud-sync-scheduler.test.ts b/tests/unit/cloud-sync-scheduler.test.ts
new file mode 100644
index 000000000..a68d9e33e
--- /dev/null
+++ b/tests/unit/cloud-sync-scheduler.test.ts
@@ -0,0 +1,74 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+// The scheduler used to self-fetch POST /api/sync/cloud without credentials,
+// which the route answers with 401 once a dashboard password is set, so
+// scheduled sync silently never ran. It must now sync in-process and talk to
+// CLOUD_URL directly.
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-cloud-sync-scheduler-"));
+const ORIGINAL_DATA_DIR = process.env.DATA_DIR;
+const ORIGINAL_CLOUD_URL = process.env.CLOUD_URL;
+const ORIGINAL_FETCH = globalThis.fetch;
+
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.CLOUD_URL = "https://cloud.example";
+if (!process.env.API_KEY_SECRET) {
+  process.env.API_KEY_SECRET = "test-cloud-sync-scheduler-secret-" + Date.now();
+}
+
+const coreDb = await import("../../src/lib/db/core.ts");
+const apiKeysDb = await import("../../src/lib/db/apiKeys.ts");
+const settingsDb = await import("../../src/lib/db/settings.ts");
+const { CloudSyncScheduler } = await import("../../src/shared/services/cloudSyncScheduler.ts");
+
+test.after(() => {
+  apiKeysDb.resetApiKeyState();
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+  globalThis.fetch = ORIGINAL_FETCH;
+  if (ORIGINAL_DATA_DIR === undefined) delete process.env.DATA_DIR;
+  else process.env.DATA_DIR = ORIGINAL_DATA_DIR;
+  if (ORIGINAL_CLOUD_URL === undefined) delete process.env.CLOUD_URL;
+  else process.env.CLOUD_URL = ORIGINAL_CLOUD_URL;
+});
+
+test("scheduled sync uploads to CLOUD_URL in-process even when login is required", async () => {
+  await settingsDb.updateSettings({ cloudEnabled: true, requireLogin: true, password: "hashed" });
+
+  const calls: string[] = [];
+  globalThis.fetch = async (url) => {
+    calls.push(String(url));
+    return new Response(JSON.stringify({ changes: {} }), { status: 200 });
+  };
+
+  const scheduler = new CloudSyncScheduler("machine-1");
+  const result = (await scheduler.sync()) as { success?: boolean };
+
+  assert.deepEqual(calls, ["https://cloud.example/sync/machine-1"]);
+  assert.equal(result.success, true);
+});
+
+test("scheduled sync surfaces upstream failures instead of reporting success", async () => {
+  await settingsDb.updateSettings({ cloudEnabled: true });
+  globalThis.fetch = async () => new Response("boom", { status: 500 });
+
+  const scheduler = new CloudSyncScheduler("machine-1");
+  await assert.rejects(() => scheduler.sync(), /Cloud sync failed/);
+  assert.equal(await scheduler.syncWithRetry(), null);
+});
+
+test("scheduled sync is a no-op while cloud sync is disabled", async () => {
+  await settingsDb.updateSettings({ cloudEnabled: false });
+  let called = false;
+  globalThis.fetch = async () => {
+    called = true;
+    return new Response("{}");
+  };
+
+  assert.equal(await new CloudSyncScheduler("machine-1").sync(), null);
+  assert.equal(called, false);
+});
