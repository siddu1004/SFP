{
  "name": "sfp-hive",
  "displayName": "SFP Hive",
  "description": "Choose the few agent skills a task needs, in order, from the SFP library. Works in VS Code and in Antigravity and other VS Code forks.",
  "version": "0.2.0",
  "publisher": "siddu1004",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/siddu1004/SFP.git", "directory": "extensions/antigravity-hive"},
  "engines": {"vscode": "^1.85.0"},
  "categories": ["AI", "Other"],
  "keywords": ["skills", "agent", "antigravity", "sfp", "hive"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {"activitybar": [{"id": "sfpHive", "title": "SFP Hive", "icon": "media/hive.svg"}]},
    "views": {
      "sfpHive": [
        {"type": "webview", "id": "sfpHive.stack", "name": "SFP Hive"},
        {"type": "webview", "id": "sfpHive.library", "name": "Skill Library"}
      ]
    },
    "chatParticipants": [
      {
        "id": "sfp.hive",
        "name": "hive",
        "fullName": "SFP Hive",
        "description": "Agent skills advisor powered by SFP Hive",
        "isDefault": false
      }
    ],
    "commands": [
      {"command": "sfpHive.choose", "title": "Choose skills for a task", "category": "SFP Hive", "icon": "$(search)"},
      {"command": "sfpHive.focusNow", "title": "Show current agent skills and phase", "category": "SFP Hive"},
      {"command": "sfpHive.focusLibrary", "title": "Focus skill library", "category": "SFP Hive"},
      {"command": "sfpHive.searchSkills", "title": "Search skills", "category": "SFP Hive", "icon": "$(search)"},
      {"command": "sfpHive.applyBundle", "title": "Apply a bundle", "category": "SFP Hive"},
      {"command": "sfpHive.copyPrompt", "title": "Copy the agent prompt", "category": "SFP Hive", "icon": "$(copy)"},
      {"command": "sfpHive.openSkill", "title": "Open skill", "category": "SFP Hive"},
      {"command": "sfpHive.helped", "title": "This skill helped", "category": "SFP Hive", "icon": "$(thumbsup)"},
      {"command": "sfpHive.unhelpful", "title": "This skill did not help", "category": "SFP Hive", "icon": "$(thumbsdown)"},
      {"command": "sfpHive.ignored", "title": "Chosen but never used", "category": "SFP Hive", "icon": "$(circle-slash)"},
      {"command": "sfpHive.missing", "title": "Report a missing skill", "category": "SFP Hive", "icon": "$(add)"},
      {"command": "sfpHive.status", "title": "Show what the hive has learned", "category": "SFP Hive"},
      {"command": "sfpHive.train", "title": "Train the hive model", "category": "SFP Hive"},
      {"command": "sfpHive.install", "title": "Install SFP skills into this workspace", "category": "SFP Hive"},
      {"command": "sfpHive.rules", "title": "Add the standing hive instruction to this workspace", "category": "SFP Hive"},
      {"command": "sfpHive.apps", "title": "Set up a program a skill needs (OmniRoute, Strix...)", "category": "SFP Hive"},
      {"command": "sfpHive.clusterAdd", "title": "Create a new skill cluster", "category": "SFP Hive"},
      {"command": "sfpHive.clusterRemove", "title": "Remove a skill cluster of your own", "category": "SFP Hive"}
    ],
    "menus": {
      "commandPalette": [
        {"command": "sfpHive.openSkill", "when": "false"},
        {"command": "sfpHive.helped", "when": "false"},
        {"command": "sfpHive.unhelpful", "when": "false"},
        {"command": "sfpHive.ignored", "when": "false"}
      ]
    },
    "configuration": {
      "title": "SFP Hive",
      "properties": {
        "sfpHive.sfpPath": {"type": "string", "default": "", "description": "Folder of your SFP checkout. Empty uses the one the SFP installer recorded in ~/.sfp/root."},
        "sfpHive.python": {"type": "string", "default": "", "description": "Python 3 command. Empty uses python3 (python on Windows)."},
        "sfpHive.maxSkills": {"type": "number", "default": 4, "minimum": 1, "maximum": 8, "description": "The most skills to choose for one task."},
        "sfpHive.copyPromptAfterChoosing": {"type": "boolean", "default": true, "description": "Copy the agent prompt to the clipboard after choosing, ready to paste into the agent panel."},
        "sfpHive.installTool": {"type": "string", "default": "antigravity", "description": "The SFP installer tool name used by the install commands (antigravity, copilot for VS Code, cursor, windsurf...)."},
        "sfpHive.follow": {"type": "boolean", "default": true, "description": "Follow workspace activity and update skills to match the current phase of work."},
        "sfpHive.followCommands": {"type": "boolean", "default": true, "description": "Include terminal commands in workspace activity when shell integration is available."}
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test \"test/*.test.js\"",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
