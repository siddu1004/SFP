  "meta": {
    "title": "MCP Client Provider Open and Recovery",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1060, 640],
    "views": [
      {
        "id": "fast-handshake",
        "label": "Fast initialize",
        "focus": ["host", "lifespan", "provider", "opentask"],
        "note": "Lifespan starts one background open and yields immediately, so MCP initialize does not wait for Google authentication."
      },
      {
        "id": "single-flight-get",
        "label": "First tool call",
        "focus": ["host", "tool", "provider", "opentask", "factory"],
        "note": "Tool calls join the same open through asyncio.shield; cancellation of one waiter does not cancel shared warm-up."
      },
      {
        "id": "retry-and-close",
        "label": "Failure and shutdown",
        "focus": ["lifespan", "tool", "provider", "opentask", "factory"],
        "note": "A failed open clears only its own slot for the next call; shutdown cancels warm-up or exits the owned context manager."
      }
    ]
  },
  "participants": [
    {"id": "host", "type": "external", "label": "MCP Host", "sublabel": "initialize / tools"},
