    {"id": "provider", "type": "backend", "label": "ClientProvider", "sublabel": "single-flight owner"},
    {"id": "opentask", "type": "messagebus", "label": "Open Task", "sublabel": "shared asyncio task"},
    {"id": "factory", "type": "backend", "label": "Client Factory", "sublabel": "async context manager"}
