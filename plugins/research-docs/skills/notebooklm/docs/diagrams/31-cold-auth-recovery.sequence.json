    {"participant": "recovery", "from": 368, "to": 560, "type": "security"},
    {"participant": "headless", "from": 428, "to": 440, "type": "security"},
    {"participant": "master", "from": 458, "to": 500, "type": "security"},
    {"participant": "store", "from": 300, "to": 500, "type": "database"}
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One Ordered Ladder",
      "items": [
        "_fetch_tokens_with_refresh_core owns the ordered ladder"
      ]
    },
    {
      "dot": "violet",
      "title": "Concurrency Boundaries",
      "items": [
        "ColdRecoveryState serializes each path; SingleFlight keys by path plus rung policy",
        "L2.5 refresh-command execution uses its own single flight"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-Closed Conditions",
      "items": [
        "Env auth skips file recovery; exhaustion preserves the error"
      ]
    }
